WorldInfo {
  info [
    "Tutorial 5: haltere de 2 kg (cilindro + 2 esferas), centro de massa deslocado"
    "e ContactProperties default/dumbbell (troque coulombFriction para 0 e veja deslizar)."
  ]
  title "Oficina - T5: solido composto"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "dumbbell"
      coulombFriction [
        1
      ]
    }
  ]
}
