DEF HALTERE Solid {
  translation -0.1 -0.25 0.1
  rotation 0 1 0 1.5708
  children [
    DEF G0 Group {
      children [
        Shape {
          appearance DEF METAL_ESCOVADO PBRAppearance {
            baseColor 0.55 0.57 0.6
            roughness 0.35
            metalness 0.8
          }
          geometry Cylinder {
            height 0.1
            radius 0.01
          }
        }
        Pose {
          translation 0 0 0.05
          children [
            DEF PESO Shape {
              appearance DEF FERRO_FUNDIDO PBRAppearance {
                baseColor 0.12 0.12 0.13
                roughness 0.8
                metalness 0.4
              }
              geometry Sphere {
                radius 0.03
                subdivision 2
              }
            }
          ]
        }
        Pose {
          translation 0 0 -0.05
          children [
            USE PESO
          ]
        }
      ]
    }
  ]
  name "haltere"
  contactMaterial "dumbbell"
  boundingObject USE G0
  physics Physics {
    density -1
    mass 2
    centerOfMass [
      0 0 0.01
    ]
  }
}
