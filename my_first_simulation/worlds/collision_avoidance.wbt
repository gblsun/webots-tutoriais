DEF BOLA_TIJOLO Solid {
  translation -0.05 0.1 0.2
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture {
          url [
            "textures/red_brick_wall.jpg"
          ]
        }
        roughness 0.5
        metalness 0
      }
      geometry DEF BALL_GEOMETRY Sphere {
        radius 0.05
        subdivision 2
      }
    }
  ]
  name "bola de tijolo"
  boundingObject USE BALL_GEOMETRY
  physics Physics {
  }
}
